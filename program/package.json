{
  "name": "ronin-rewards-program",
  "version": "0.1.0",
  "description": "Ronin Rewards Solana Anchor program — pays SOL to users who claim Samurai Points rewards",
  "private": true,
  "scripts": {
    "build": "anchor build",
    "test": "anchor test",
    "test:localnet": "anchor test --provider.cluster localnet",
    "test:devnet": "anchor test --provider.cluster devnet",
    "deploy:mainnet": "bash scripts/deploy-mainnet.sh",
    "verify": "node scripts/verify-program.mjs",
    "lint": "echo 'No linter configured — Solana Playground did not use one.'"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.30.1",
    "@solana/web3.js": "^1.91.0"
  },
  "devDependencies": {
    "chai": "^4.4.1",
    "mocha": "^10.4.0",
    "ts-mocha": "^10.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18"
  }
}

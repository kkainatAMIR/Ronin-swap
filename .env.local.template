# =====================================================================
# RoninSwap .env.local — fill in YOUR values
# =====================================================================
# This file is gitignored (never committed). Copy your real credentials
# here for local development.
#
# For production (Vercel), set the same variables in Vercel Project
# Settings → Environment Variables.
# =====================================================================

# ─── Solana RPC (REQUIRED for claim flow) ───
# Option A: Use Helius (recommended — fast, no rate limits)
#   Get a free key at https://dashboard.helius.dev/
#   Create an app, choose "Solana Mainnet", copy the API key.
HELIUS_API_KEY=

# Option B: Use a direct Solana RPC URL (if you have your own endpoint)
#   Leave SOLANA_RPC_URL empty if using HELIUS_API_KEY above.
#   The proxy will auto-construct the Helius URL from the key.
SOLANA_RPC_URL=

# Option C: If BOTH are empty, the proxy falls back to the public
#   Solana RPC (https://api.mainnet-beta.solana.com) — which is
#   heavily rate-limited and will cause "Failed to fetch" errors
#   on the claim flow. DO NOT rely on this in production.

# ─── Supabase (REQUIRED for wallet-link + claims) ───
#   Find these in your Supabase Dashboard → Project Settings → API.
#   URL looks like: https://xxxxxxxxxxxx.supabase.co
#   Key is the "service_role" secret (NOT the anon key).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── $RONIN mint (already has a default — no change needed) ───
# RONIN_MINT_ADDRESS=2JVEVXoRsskapZ8T56MjMNJq6Dk3feEUYSRmzkkipump

# ─── Jupiter (Solana swap) ───
#   Required for Swap V2 /order + /execute.
JUPITER_API_KEY=
JUPITER_BASE_URL=https://api.jup.ag

# ─── Robinhood Chain (EVM L3) ───
VITE_ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com/
VITE_ROBINHOOD_EXPLORER_URL=https://robinhoodchain.blockscout.com/
VITE_ROBINHOOD_NETWORK_NAME=Robinhood Chain

# ─── Ethereum (EVM) ───
ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com

# ─── Admin auth (optional — for the admin dashboard) ───
#   Comma-separated list of Solana wallet addresses that can access
#   the admin panel. Leave empty to disable admin features.
# ADMIN_WALLET_ADDRESSES=your_solana_wallet_address_here

# =====================================================================
# Ronin-swap environment variables
# =====================================================================
# Copy this file to `.env.local` for local development, or set the same
# variables in Vercel Project Settings → Environment Variables for
# Production / Preview / Development.
#
# Variables WITHOUT a `VITE_` prefix are server-only — they are read by
# the Vercel serverless functions under /api and are NEVER bundled into
# the browser. Variables WITH a `VITE_` prefix ARE exposed to the
# browser and must never contain secrets.
# =====================================================================

# ─── Solana ───
VITE_SOLANA_RPC_URL=                          # optional browser RPC fallback (public)
SOLANA_RPC_URL=                               # server-only RPC for /api/solana/rpc
HELIUS_API_KEY=                               # server-only — required for /api/solana/enhanced

# ─── $RONIN mint ───
VITE_RONIN_MINT_ADDRESS=                      # optional frontend override for the $RONIN mint
RONIN_MINT_ADDRESS=                           # server-side source of truth
RONIN_BURN_ADDRESS=                           # optional dead/burn wallet

# ─── Jupiter (Solana swap) ───
JUPITER_API_KEY=                              # required for Swap V2 /order + /execute
JUPITER_BASE_URL=https://api.jup.ag
JUPITER_REFERRAL_ACCOUNT=Cx98B695q8Dvum68sUdyopp8Gxh4fhZv1QhmE1mgpu47
JUPITER_REFERRAL_FEE_BPS=50
JUPITER_V2_REFERRAL_ENABLED=

# ─── Sol Incinerator (burn) ───
SOL_INCINERATOR_API_KEY=
SOL_INCINERATOR_BASE_URL=https://v2.api.sol-incinerator.com

# ─── RONIN Shield ───
RONIN_SHIELD_TREASURY_ADDRESS=

# ─── Robinhood Chain (EVM L3, chainId 4663) ───
# Used by MetaMask add/switch + by the /api/robinhood/* handlers.
VITE_ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com/
VITE_ROBINHOOD_EXPLORER_URL=https://robinhoodchain.blockscout.com/
VITE_ROBINHOOD_NETWORK_NAME=Robinhood Chain
# Server-only override (optional; falls back to the VITE_ value above):
# ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com/

# ─── Ethereum Mainnet (EVM, chainId 1) ───
# Public RPC used by /api/ethereum/* and /api/evm/* handlers when no
# Alchemy key is configured. Defaults to a free public endpoint.
ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com

# Alchemy API key — REQUIRED for full Ethereum wallet-token discovery.
# Without this key, the swap picker only shows balances for the 22-token
# featured catalog. WITH the key, the picker discovers every ERC-20 the
# wallet actually holds (via alchemy_getTokenBalances + metadata).
# Get a free key at https://dashboard.alchemy.com/ — sign up, create an
# app, choose "Ethereum Mainnet", copy the API key.
# Server-only — never prefixed with VITE_.
ALCHEMY_API_KEY=

# ─── LI.FI (cross-chain / Robinhood Chain routing) ───
LIFI_BASE_URL=https://li.quest/v1
LIFI_INTEGRATOR=RoninSamurai
LIFI_API_KEY=                                 # server-only; optional for higher LI.FI limits
LIFI_FEE_ENABLED=
LIFI_FEE_BPS=50
LIFI_FEE_RECEIVER=
LIFI_APPROVED_TOKENS=

# ─── Supabase (Samurai Points / leaderboard / rewards accounting) ───
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Admin auth ───
ADMIN_WALLET_ADDRESSES=

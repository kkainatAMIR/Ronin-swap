# Browser-visible configuration
VITE_SOLANA_RPC_URL=
VITE_RONIN_MINT_ADDRESS=

# Server-only configuration: never use the VITE_ prefix
# Required for RONIN Shield support/confirmation + reads: the server proxy
# (/api/solana/rpc) uses these, avoiding browser CORS/403 RPC failures.
SOLANA_RPC_URL=             # server-side RPC used by /api/solana/rpc
RONIN_MINT_ADDRESS=
# Optional; defaults to the published ecosystem RONIN burn wallet in api/ronin/stats.mjs.
RONIN_BURN_ADDRESS=
# Free key from dashboard.helius.com. Fixes HTTP 403 "Access forbidden" RPC errors
# (browser block); used automatically by the server-side RPC proxy.
HELIUS_API_KEY=
JUPITER_API_KEY=
JUPITER_BASE_URL=https://api.jup.ag
SOL_INCINERATOR_API_KEY=
SOL_INCINERATOR_BASE_URL=https://v2.api.sol-incinerator.com

# RONIN Shield optional support treasury (built-in default is a demo placeholder -
# set the real treasury for production; both variables should use the same address)
RONIN_SHIELD_TREASURY=7xKXtg2CW87d97TXJSDpbD5jBkheTqA83TZRuJosgAsU
VITE_RONIN_SHIELD_TREASURY=7xKXtg2CW87d97TXJSDpbD5jBkheTqA83TZRuJosgAsU

# Jupiter Swap V2 referral fee (RoninSamurai.com)
# /swap/v2/order requires referralAccount + referralFee (50-255 bps).
# Swap V2 / Ultra referral accounts and their token accounts must be
# initialized under project DkiqsTrw1u1bYFumumC7sCG2S8K25qc2vemJFHyW2wJc.
JUPITER_REFERRAL_ACCOUNT=Cx98B695q8Dvum68sUdyopp8Gxh4fhZv1QhmE1mgpu47
JUPITER_REFERRAL_FEE_BPS=50